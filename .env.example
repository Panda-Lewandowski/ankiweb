# Single quotes preserve literal $ characters in Argon2 hashes under Compose.
# Generate privately: .venv/bin/python -m ankiweb.auth hash-password
ANKIWEB_PASSWORD_HASH=''
ANKIWEB_APP_SECRET=''
ANKIWEB_ALLOWED_HOSTS=trainer.example.com
ANKIWEB_AUTH_ALLOWED_ORIGINS=https://trainer.example.com
# Replace with the exact public 40-character commit URL and verify its source archive.
ANKIWEB_SOURCE_URL=
ANKIWEB_COLLECTION_PATH=/data/anki/current/collection.anki2
